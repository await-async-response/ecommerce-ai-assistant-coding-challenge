# Copy this file to .env (which is git-ignored) to override defaults.

# Location of the SQLite database file. Relative paths are resolved from the
# repository root.
DATABASE_PATH=database/ecommerce.sqlite

# Optional: set an API key to use the OpenAI intent parser instead of the built-in
# deterministic fallback parser.
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini
